        android:pathData="M46,50 L68,28 C69.5,26.5 72,26.5 73.5,28 L77.5,32 C79,33.5 79,36 77.5,37.5 L58.5,56.5 C57,58 54.5,58 53,56.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="46"
                android:startY="26"
                android:endX="79"
                android:endY="58"
                android:type="linear">
                <item android:color="#FF2C2C2C" android:offset="0.0" />
                <item android:color="#FF171717" android:offset="0.6" />
                <item android:color="#FF111111" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lower diagonal arm of the K (3D pill shape) -->
    <path
        android:pathData="M54,53.5 L74,73.5 C75.5,75 75.5,77.5 74,79 L70,83 C68.5,84.5 66,84.5 64.5,83 L45,63.5 C43.5,62 43.5,59.5 45,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45"
                android:startY="54"
                android:endX="75"
                android:endY="84"
                android:type="linear">
                <item android:color="#FF262626" android:offset="0.0" />
                <item android:color="#FF171717" android:offset="0.6" />
                <item android:color="#FF0D0D0D" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central connection node / tactile soft 3D sphere -->
    <path
        android:pathData="M48,53 A7,7 0 1,0 48,53.01 Z"
        android:fillColor="#15111111" />
    <path
        android:pathData="M47.5,52 A6,6 0 1,0 47.5,52.01 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="48"
                android:endX="51"
                android:endY="55"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FFE0E0DC" android:offset="0.7" />
                <item android:color="#FFCACAC7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central sphere specular highlight -->
    <path
        android:pathData="M46,49.5 A1.5,1.5 0 1,0 46,49.51 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Terminal orb on upper branch representing connection point -->
    <path
        android:pathData="M73,32.5 A4,4 0 1,0 73,32.51 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="71"
                android:startY="30"
                android:endX="75"
                android:endY="34"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FFD6D6D2" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

