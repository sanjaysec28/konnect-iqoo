        android:pathData="M34,29 C34,26.5 36.5,24.5 39,24.5 L46,24.5 C48.5,24.5 50.5,26.5 50.5,29 L50.5,79 C50.5,81.5 48.5,83.5 46,83.5 L39,83.5 C36.5,83.5 34,81.5 34,79 Z"
        android:fillColor="#15111111" />
    <path
        android:pathData="M48,50 L71,28 C73,26 76,26 78,28 L81,31 C83,33 83,36 81,38 L62,56 L82,76 C84,78 84,81 82,83 L79,86 C77,88 74,88 72,86 L48,62 Z"
        android:fillColor="#15111111" />

    <!-- Vertical Stem of the K (Physical Soft 3D bar) -->
    <path
        android:pathData="M33,28 C33,25.8 34.8,24 37,24 L44,24 C46.2,24 48,25.8 48,28 L48,78 C48,80.2 46.2,82 44,82 L37,82 C34.8,82 33,80.2 33,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="33"
                android:startY="24"
                android:endX="48"
                android:endY="82"
                android:type="linear">
                <item android:color="#FF242424" android:offset="0.0" />
                <item android:color="#FF171717" android:offset="0.5" />
                <item android:color="#FF0D0D0D" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stem top highlight edge -->
    <path
        android:pathData="M35,26 L42,26"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />

    <!-- Upper diagonal arm of the K (3D pill shape) -->
